# Normalise to LF in the repository; check out platform-native where it matters.
* text=auto eol=lf

# Shell scripts must keep LF even on Windows checkouts: a CRLF shebang line
# makes bash fail with a confusing "bad interpreter" error.
*.sh text eol=lf

# PowerShell is happy either way; CRLF avoids editor surprises on Windows.
*.ps1 text eol=crlf

# Fixtures are compared byte-for-byte by the tests.
tests/fixtures/** text eol=lf
