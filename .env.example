# Copy to .env and fill in. .env is git-ignored; never commit real values.

# SerpApi key for the serpapi-google-news discovery provider.
# Leave empty to run without it: manual-urls and the best-effort
# google-news-rss provider still work.
SERPAPI_API_KEY=

# Contact address advertised in the User-Agent so site operators can reach
# you. Required by configs/default.yaml unless you edit the config.
CRAWLER_CONTACT_EMAIL=

# Path to the YAML config, relative to the repository root or absolute.
NEWS_CONFIG_PATH=configs/default.yaml
